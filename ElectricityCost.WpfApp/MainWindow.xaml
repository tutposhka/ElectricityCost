<Window x:Class="ElectricityCost.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elektrikulu kalkulaator"
        Height="420"
        Width="450">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock Text="Seadme võimsus (W):"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="PowerTextBox"
                     Height="30"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Töötunnid päevas:"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="HoursTextBox"
                     Height="30"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Elektri hind (€/kWh):"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="PriceTextBox"
                     Height="30"
                     Margin="0,0,0,15"/>

            <Button x:Name="CalculateButton"
                    Content="Arvuta"
                    Height="35"
                    Click="Calculate_Click"
                    Margin="0,0,0,10"/>

            <Button x:Name="ClearButton"
                    Content="Tühjenda"
                    Height="35"
                    Click="Clear_Click"
                    Margin="0,0,0,15"/>

            <TextBlock x:Name="ResultTextBlock"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,5"/>

            <TextBlock x:Name="ErrorTextBlock"
                       TextWrapping="Wrap"/>

        </StackPanel>

    </Grid>
</Window>